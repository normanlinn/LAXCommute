# These are public browser credentials. Never put a Supabase service-role key here.
VITE_SUPABASE_URL=https://yzdoarjleozzblvsjbhx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_AkClR2bp72pGci-NAX1DBQ_8INzT0v1

# Free embedded Leaflet/OpenStreetMap map. No key needed.
VITE_MAP_PROVIDER=openstreetmap
# To switch tile providers later, configure its URL template and required attribution.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=

# Optional Apple MapKit JS alternative: set VITE_MAP_PROVIDER=apple, then add
# a domain-restricted Maps token from Apple Developer > Services > Maps.
VITE_APPLE_MAPS_TOKEN=

# Conservative free-tier default. Value is in milliseconds (minimum 30000).
VITE_REFRESH_INTERVAL_MS=60000
