{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laxcommute-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "6884002",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "6884001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  // One Durable Object per "bus is close" alert, so pushes reach a closed app.
  // Keys: run `node scripts/generate-vapid.mjs`, then the two `wrangler secret put` commands it prints.
  "durable_objects": {
    "bindings": [{ "name": "BUS_ALERTS", "class_name": "BusAlert" }],
  },
  "migrations": [{ "tag": "v1-bus-alerts", "new_sqlite_classes": ["BusAlert"] }],
  "vars": { "VAPID_SUBJECT": "https://employeeshuttlelax.com" },
  "observability": { "enabled": true },
}
